{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./static",
    "rootDir": "./src",
    "sourceMap": false,
    "removeComments": false
  },
  "include": ["src/**/*"]
}
